@article{ WOS:001519916100001,
Author = {Kumar, Vinay and Singh, Gurwinder and Husain, Minhaz and Kumar, Ranvijay
   and Meena, Harnarayan and Singh, Rupinder and Hashmi, M. S. J.},
Title = {Some investigations on hybrid 3D printed PVDF-based functional
   prototypes},
