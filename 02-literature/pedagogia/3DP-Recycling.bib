Author = {Fan, Weiqiang and Wang, Yongzhen and Liu, Rulin and Zou, Jing and Yu,
   Xiang and Liu, Yaming and Zhi, Chao and Meng, Jiaguang},
Title = {Textile production by additive manufacturing and textile waste
   recycling: a review},
