@inproceedings{ WOS:001425310400004,
Author = {Kladovasilakis, Nikolaos and Natsios, Ioannis and Pech-livani,
   Eleftheria Maria and Tzetzis, Dimitrios and Tzovaras, Dimitrios},
Editor = {Kostavelis, I and Folinas, D and Aidonis, D and Achillas, C},
Title = {Valorizing Automotive Tire Waste via Additive Manufacturing Technologies},
Booktitle = {SUPPLY CHAINS, PT II, ICSC 2024},
Series = {Communications in Computer and Information Science},
Year = {2025},
Volume = {2111},
