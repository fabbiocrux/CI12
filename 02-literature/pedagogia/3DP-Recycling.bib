@inproceedings{ WOS:001554118700048,
Author = {Zhou, Zhijun and Tao, Simin},
Editor = {Stephanidis, C and Antona, M and Ntoa, S and Salvendy, G},
Title = {RecyCubic: A More Environmental-Friendly 3D Printing Service System},
