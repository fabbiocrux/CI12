@article{ WOS:001501029000001,
Author = {Harale, Akshay A. and Jadhav, D. B. and Jadhav, P. V. and Mohite, Dadaso
   D. and Unde, Sanket S.},
Title = {Revolutionizing Orthopedics through Integration of Artificial
   Intelligence and 3D Printing for Enhanced Patient Care},
