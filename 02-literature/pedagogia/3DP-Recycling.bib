Type = {Article},
Language = {English},
Affiliation = {Hua, SD (Corresponding Author), Nanjing Tech Univ, Coll Mat Sci \& Engn, Nanjing 211816, Peoples R China.
   Wang, Yuntao; Jiang, Shangjin; Hua, Sudong; Yue, Hongfei; Zhang, Yanan, Nanjing Tech Univ, Coll Mat Sci \& Engn, Nanjing 211816, Peoples R China.},
