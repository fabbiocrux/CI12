@article{ WOS:001395425700001,
Author = {Villarreal-Martinez, Diego and Patino-Almanza, Rodrigo and
   Gonzalez-Calderon, J. Amir and Almendarez-Camarillo, Armando},
Title = {Use of PET \& iPP bottle waste reinforced with graphene oxide to produce
   3D printing filament},
Journal = {MRS ADVANCES},
Year = {2025},
Volume = {10},
Number = {6, SI},
Pages = {714-721},
Month = {MAR},
Abstract = {Recycled polyethylene terephthalate filament (R-PET) and recycled
   polypropylene filament (R-iPP) were successfully obtained from a
   recycling device called Polyformer which were reinforced with graphene
   oxide (GO) by dip-coating technique for use in 3D printing. The
   filaments were characterized by Differential Scanning Calorimetry (DSC)
   to obtain the main thermal transitions of the composite, such as its
   glass transition temperature (Tg), melting, and crystallization
   temperature (Tm and Tc, respectively). The specimens were printed
   according to ASTM D4065 standard and were characterized by dynamic
   mechanical analysis (DMA) to observe the impact of graphene oxide as
   reinforcement on the storage modulus of the material. The
   thermomechanical results indicate enhanced performance of the iPP-G
   composite, exhibiting a 21\% increase in storage modulus and a shift in
   the glass transition temperature (Tg), indicative of effective
   interfacial bonding between the graphene oxide and the recycled iPP
   matrix.Graphical abstract Reinforcement of recycled commodity polymers
   for 3D printing},
