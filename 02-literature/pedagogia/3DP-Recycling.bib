@article{ WOS:001514229000001,
Author = {Olivera, Andres F. and Chica, Edwin L. and Colorado, Henry A.},
Title = {Evaluation of thermoplastic composites for the manufacture of H-Darrieus
   wind Turbine blades on a laboratory scale},
Journal = {JOURNAL OF MATERIALS RESEARCH AND TECHNOLOGY-JMR\&T},
Year = {2025},
Volume = {37},
Pages = {1310-1323},
Month = {JUL-AUG},
Abstract = {Wind energy is one of the most widely produced sources of renewable and
   clean electricity. However, the blades of wind turbines pose a
   significant environmental challenge due to the difficulty in recycling
   them. To address this issue, research is focused on finding a recyclable
   and easily manufacturable thermoplastic material. This study compares
   four thermoplastic materials fabricated using 3D printing: polylactic
   acid (PLA), PLA with carbon fiber reinforcements (PLA + C.F.),
   polyethylene terephthalate glycol (PETG), and PETG with carbon fiber
   reinforcements (PETG + C.F.). The material with the best properties will
   be used in the manufacturing of vertical wind turbine blades. Samples
   underwent tests for tensile strength, flexural strength, impact
   resistance, hardness, thermal aging, and UV exposure. The results
   demonstrated that PETG + C.F. is the most suitable material to produce
   wind turbine blades, as it exhibits excellent tensile and flexural
   strength, elasticity, thermal resistance, and improved hardness when
   exposed to ultraviolet radiation. It was found that PETG + C.F. made at
   250 degrees C has the best properties for the fabrication of wind
   turbine blades. The incorporation of carbon fibers within the PETG
   matrix significantly improves the tensile strength.},
Publisher = {ELSEVIER},
