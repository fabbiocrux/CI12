@article{ WOS:001423351300001,
Author = {Li, Siwei and Wu, Haihua and Huang, Caihua and Zeng, Shiyu and Gong,
   Liang and Ye, Xicong and Zhang, Hualong and Gao, Aodong and Liu, Mingmin},
Title = {Waste into wealth: Plasticization treatment of waste graphite powder and
   efficient impregnation strategy for the preparation of graphite blocks},
Journal = {MATERIALS SCIENCE AND ENGINEERING B-ADVANCED FUNCTIONAL SOLID-STATE
   MATERIALS},
Year = {2025},
Volume = {314},
Month = {APR},
Abstract = {Recycling the graphite powder generated during the processing of
   traditional graphite blocks (GBs) are crucial for reducing resource
   waste and managing graphite dust pollution. With the emergence of the
   dual-carbon economy, the recycling of waste graphite powder (WGP) has
   gained significant attention in academia and industry. However, due to
   its high degree of graphitization, past recycling efforts have been
   limited to low value-added industries, leading to resource wastage and
   pollution. In this paper, WGP is utilized as the primary raw material,
   with a resin transition layer constructed on its surface using a
   thermosetting phenolic resin solution (PFS), forming WGP@PFS. This
   imparts plasticity to the otherwise brittle graphite powder. A
   combination of micro-hot pressing additive manufacturing and electric
   field-driven jet deposition 3D printing (EJD) creates a network within
   the substrate, enhancing the impregnation effect. Without the need for
   high-temperature graphitization (similar to 3000 degrees C) and relying
   solely on atmospheric pressure carbonization, the produced graphite
   blocks (GBS-WJ) exhibit impressive properties, including a bulk density
   of 1.77 g/cm(3), compressive strength of 60.76 MPa, and thermal
   conductivity of 50.34 W/(m<middle dot>K). This approach reduces energy
   consumption and process time, offering a novel method for WGP recycling.},
