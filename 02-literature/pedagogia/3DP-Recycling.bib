@article{ WOS:001530650500001,
Author = {Shen, Sufen and Shao, Wenqin and Liu, Zongsheng and Ge, Bangdong and Ma,
   Meng and Chen, Si and Shi, Yanqin and He, Huiwen and Zhu, Yulu and Wang,
   Xu},
Title = {Mechanically tunable, shape memory, recyclable and reprintable 3D
   printed polyurethane materials based on hindered urea bonds},
Journal = {EUROPEAN POLYMER JOURNAL},
Year = {2025},
Volume = {236},
Month = {AUG 20},
Abstract = {Photopolymerization 3D printing technology is an efficient and precise
   advanced manufacturing method. However, most current photopolymerization
   precursors achieve rapid conversion from liquid to solid through
   multifunctional monomers, which often results in the production of large
   amounts of non-recyclable thermosetting materials, thereby exacerbating
   resource waste and environmental pollution. Therefore, this work
   employed a solvent-free method to synthesize a novel polyurethane
   acrylate (PUB) prepolymer containing hindered urea bonds (HUB),
   achieving recyclability and shape memory functionality in the 3D printed
   materials (PUB/IBOA). In the PUB/IBOA materials, the hindered urea bond
   was dynamically dissociated at 90 degrees C, rapidly destroying the
   original crosslinking network. The dissociated -NCO reacted with the -NH
   group in tert-butylamine ethyl methacrylate (TBEMA) to regenerate the
   PUB monomer, which then participated in photocuring 3D printing,
   realizing the recycling of 3D printed materials. Additionally, by
   adjusting the molecular weight of the prepolymer, the mechanical
   properties of the PUB/IBOA material can be effectively regulated to suit
   a wider range of application scenarios. The 3D printed material had
   shape memory functionality, enabling the storage and transportation of
   large-scale products, thereby further enhancing the sustainability and
   functionality of 3D printed materials.},
