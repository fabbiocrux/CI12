@article{ WOS:001210664700001,
Author = {Keane, Gavin and Healy, Andrew V. and Devine, Declan M.},
Title = {Post-Process Considerations for Photopolymer 3D-Printed Injection
   Moulded Insert Tooling Applications},
Journal = {JOURNAL OF COMPOSITES SCIENCE},
