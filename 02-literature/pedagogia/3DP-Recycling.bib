Title = {Low Carbon Footprint Magnesium Phosphate Cement for 3D Concrete Printing},
Booktitle = {FOURTH RILEM INTERNATIONAL CONFERENCE ON CONCRETE AND DIGITAL
   FABRICATION, DC 2024},
Series = {RILEM Bookseries},
