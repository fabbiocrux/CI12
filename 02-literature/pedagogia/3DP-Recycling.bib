@article{ WOS:001403061800001,
Author = {Vidakis, Nectarios and Petousis, Markos and Michailidis, Nikolaos and
   Papadakis, Vassilis and Mountakis, Nikolaos and Argyros, Apostolos and
   Spiridaki, Mariza and Valsamos, John},
Title = {Cyclic economy driven additive manufacturing: Valorization of
   mechanically recycled poly(methyl methacrylate) scrap in material
   extrusion 3D printing},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2025},
Volume = {486},
Month = {JAN 1},
Abstract = {Poly-{[}Methyl Methacrylate] (PMMA)-based filaments are steadily gaining
   popularity among other polymers for material extrusion additive
   manufacturing (AM). Considering the multi-billion \$ market of PMMA and
   the volume of scrap and/or manufacturing remnants and trimming, their
   mechanical recycling in the AM industry holds economic and
   sustainability potential. Herein, PMMA sheet trimmings were deployed as
   feedstock material and shredded into washed and dried pellets. The
   feedstock was melt extruded to produce filaments for the 3D printing of
   the specimens for 17 different tests. After completion of the
   qualitative and quantitative evaluation of their structural, thermal,
   rheological, mechanical, and quality scores, the specimens were shredded
   again into pellets, and the entire process was repeated for six (6)
   successive cycles. This massive experimental effort involved dozens of
   specimens and yielded excellent material-property scores. PMMA exhibited
   thermomechanical stability, marginal thermal degradation, and persistent
   printability indices throughout the mechanical recycling course.
   Substantial enhancements of 9.2\% and 5.2\%) in the tensile and flexural
   mechanical properties, respectively, were documented in the second
   thermomechanical cycle. These findings motivated the reuse of PMMA 3D
   printed parts at the end of their lifecycle.},
