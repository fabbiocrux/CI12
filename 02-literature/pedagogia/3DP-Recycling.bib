@article{ WOS:001582061000005,
Author = {Zhang, Jie and De Winkel, Joep and Gatarek, David and Sel, Kevin and
   Geyskens, Koen and Van Hooreweder, Brecht and Ferraris, Eleonora},
Title = {Temperature similarities and location-independent bond quality of
   single-walled structures via fused deposition 3D printing},
Journal = {APPLIED THERMAL ENGINEERING},
Year = {2025},
Volume = {280},
Number = {4},
Month = {DEC 1},
Abstract = {During the manufacturing of thin-walled structures with fused deposition
   3D printing, the build temperature often exhibits significant
   self-similarities due to the simple, quasi-repetitive nozzle path that
   controls the material deposition. However, such similarities or
   structured thermal patterns are less well-known and have been barely
   investigated. This study introduces three rules of temperature
   similarity in printing single-walled polymer parts: in-layer similarity,
   cross-layer similarity, and inter-layer time similarity. These rules
   have been observed in manufacturing processes with Biot numbers ranging
   from 0.03 to 0.3. Their forms, conditions, and rationales are explained
   in detail, followed by several practical applications, such as scaling
   up printing, obtaining gradient information from part cooling, and
   enabling easy setup for thermal monitoring. Notably, these rules
   establish a direct correlation between a single set of printing
   parameters-defining the material, geometry, and process conditions-and a
   spatially uniform bond quality. A new method for measuring the
   location-independent bond quality at a macro scale, based on sliding
   shear, is also presented. In a first case study in printing recycled
   poly(lactic acid) granules under forced convection, a bond strength of
   24.8 MPa was obtained from the shear-induced peeling, compared to a
   z-direction tensile strength of 17.9 MPa.},
