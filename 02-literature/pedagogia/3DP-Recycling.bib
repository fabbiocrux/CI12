@article{ WOS:001305207500001,
Author = {Lanzutti, Alex and Marin, Elia},
Title = {The Challenges and Advances in Recycling/Re-Using Powder for Metal 3D
   Printing: A Comprehensive Review},
Journal = {METALS},
Year = {2024},
Volume = {14},
Number = {8},
Month = {AUG},
Abstract = {This review explores the critical role of powder quality in metal 3D
   printing and the importance of effective powder recycling strategies. It
   covers various metal 3D printing technologies, in particular Selective
   Laser Melting, Electron Beam Melting, Direct Energy Deposition, and
   Binder Jetting, and analyzes the impact of powder characteristics on the
   final part properties. This review highlights key challenges associated
   with powder recycling, including maintaining consistent particle size
   and shape, managing contamination, and mitigating degradation effects
   from repeated use, such as wear, fragmentation, and oxidation.
   Furthermore, it explores various recycling techniques, such as sieving,
   blending, plasma spheroidization, and powder conditioning, emphasizing
   their role in restoring powder quality and enabling reuse.},
