@article{ WOS:001554131300001,
Author = {Petousis, Markos and Michailidis, Nikolaos and Kulas, Vaclav and
   Papadakis, Vassilis and Spiridaki, Mariza and Mountakis, Nikolaos and
   Argyros, Apostolos and Valsamos, John and Nasikas, Nektarios K. and
   Vidakis, Nectarios},
Title = {Sustainability-driven additive manufacturing: Implementation and content
   optimization of fine powder recycled glass in polylactic acid for
   material extrusion 3D printing},
Journal = {INTERNATIONAL JOURNAL OF LIGHTWEIGHT MATERIALS AND MANUFACTURE},
Year = {2025},
Volume = {8},
Number = {5},
Pages = {595-610},
Month = {SEP},
Abstract = {This work aimed to evaluate the capacity of recycled fine powder glass
   (RFPG) to reinforce the mechanical performance and characteristics of
   polylactic acid (PLA) for use in 3D printing (3DP) applications. Six
   composites with an RFPG filler quantity of 2.0 wt \%-12.0 wt \% (with a
   2.0 step) were evaluated. The raw materials were turned into mixtures,
   which then fabricated respective filaments. The filaments were inspected
   and tested for their properties before being utilized to produce the
   specimens for testing with 3DP. The structures, morphologies, and
   mechanical properties of the specimens were examined by performing
   respective tests, scanning electron microscopy, and micro-computed
   tomography (m-CT). Moreover, the samples were tested for their thermal
   properties through thermogravimetric and differential scanning
   calorimetry analyses, and for their rheological performance. Quality
   metrics were evaluated with m-CT (porosity and dimensional accuracy).
   The findings indicated that RFPG as a filler reinforced the PLA matrix,
   in the case of 6.0 wt \% (23.6 \% and 28.7 \% strength enhancement in
   the flexural and tensile tests respectively). The thermal properties
   were insignificantly changed with a small increase in the
   crystallization temperature, while the viscosity was significantly
   lowered with the increase of the powder content in the compounds. The
   quality metrics were enhanced as well, making this specific RFPG grade a
   promising filler for the PLA matrix in 3D printing. (c) 2025 The
   Authors. Publishing services by Elsevier B.V. on behalf of KeAi
   Communications Co. Ltd. This is an open access article under the CC
   BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/ 4.0/).},
Publisher = {KEAI PUBLISHING LTD},
Address = {16 DONGHUANGCHENGGEN NORTH ST, Building 5, Room 411, BEIJING, DONGCHENG
   DISTRICT 100009, PEOPLES R CHINA},
