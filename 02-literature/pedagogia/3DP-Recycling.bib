@article{ WOS:001458319000001,
Author = {Rahebi, Mahdi and Rezadoust, Amir Masood and Sadjadi, Samahe},
Title = {Enhanced catalytic activity and stability of Keggin-type heteropolyacid
   immobilized in 3D-printed monolithic catalysts},
Journal = {MATERIALS CHEMISTRY AND PHYSICS},
Year = {2025},
Volume = {339},
Month = {JUL 15},
Abstract = {In attempt to develop a catalytic monolith with simplified recovery and
   enhanced recyclability, 3D-printing technology has been leveraged. Three
   Keggin type heteropolyacids, including silicotungstic acid,
   phosphotungstic acid, and phosphomolybdic acid were immobilized onto
   acid-treated halloysite to form catalytically active species, which were
   then applied to 3D-printing resin to form catalytically active inks. The
   inks were printed via digital light processing technique and the
   activity of the monoliths was inspected for Knoevenagel reaction. The
   impacts of various influential parameters, encompassing the nature of
   Keggin, its loading on halloysite, and the content of
   halloysite-supported Keggin in 3D-printing ink, were investigated and
   optimized. The catalyst was highly recyclable and structurally stable
   upon recycling. It was also confirmed that leaching of silicotungstic
   acid was highly suppressed. Mechanical stability of the catalyst ensures
   consistent performance over repeated catalytic cycles, making it
   suitable for industrial applications where durability and
   costeffectiveness are a priority. Furthermore, the superior
   recyclability of the catalyst significantly contributes to sustainable
   catalysis by reducing waste and minimizing the environmental impacts
   associated with catalyst replacement. These properties not only support
   development of green processes, but also offer promising solutions for
   industrial and environmental applications, strengthening the role of
   catalyst in advancing sustainable chemical production.},
