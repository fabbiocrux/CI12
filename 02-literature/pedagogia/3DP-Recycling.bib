@article{ WOS:001544218900002,
Author = {Martinez, Wendy Elizabeth Cruz and Acosta, Yadira Karina Reyes and
   Acosta, Alfredo V. Reyes and Gomez, Ramon Enrique Diaz de Leon and
   Patel, Ami R. and Verma, Deepak Kumar and Aguilar, Cristobal N.},
Title = {Advances in Polylactic acid-based composites as a promising biomaterial
   for food packaging and biomedical Applications: Reinforcement
   strategies, functional enhancements, and future research directions},
Journal = {SUSTAINABLE MATERIALS AND TECHNOLOGIES},
Year = {2025},
Volume = {45},
Month = {OCT},
Abstract = {Polylactic acid (PLA) is a biodegradable aliphatic polyester obtained
   from renewable resources like corn and sugarcane. It has gained
   recognition as a viable sustainable substitute for fossil-based plastics
   in food packaging and biomedical applications. This review examines the
   physicochemical and biological characteristics of PLA, emphasizing its
   significantly reduced carbon footprint (up to 75 \% lower than
   polyethylene terephthalate), impressive tensile strength (sigma m), and
   biocompatibility, establishing it as a prominent biomaterial. Recent
   developments in the synthesis of PLA, particularly through optimized
   ring-opening polymerization techniques, have significantly improved its
   mechanical characteristics and biodegradability. This progress is
   expected to result in a 30 \% rise in demand for food packaging by the
   year 2025. The integration of food-derived additives such as fish
   gelatin, carvacrol, and lignin, along with natural oils including
   epoxidized soybean oil and ginger essential oil, as well as organic
   materials like bamboo fibers and cellulose nanocrystals, enhances the
   tensile strength of PLA by as much as 25 \%, increases elongation at
   break (epsilon b) by up to 300 \%, and improves barrier properties with
   a 30 \% reduction in water vapor permeability. Additionally, the use of
   antimicrobial agents such as curcumin and zinc oxide nanoparticles can
   diminish bacterial growth by up to 99 \%. Advanced processing
   techniques, including 3D printing, electrospinning, and melt extrusion,
   significantly improve the applicability of PLA in smart packaging and
   biomedical scaffolds. Notwithstanding these advancements, obstacles
   persist, such as insufficient data regarding additive migration, the
   durability over extended periods under diverse environmental conditions,
   and the scalability of methods developed in laboratory settings. This
   review highlights significant research gaps and suggests various
   recommendations, such as conducting dose-response studies, implementing
   standardized aging tests, performing techno-economic analyses, and
   executing thorough life cycle assessments (LCAs), to enhance the
   performance of PLA. Future investigations ought to concentrate on
   multifunctional PLA systems incorporating intelligent sensors,
   customized degradation profiles, and closed-loop recycling mechanisms to
   adhere to circular economy principles, thereby guaranteeing sustainable
   and highperformance solutions for food safety and biomedical
   applications.},
