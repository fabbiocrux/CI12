@inproceedings{ WOS:001323754200024,
Author = {Ahmad, Shayaan and Monroy, Roberto and Ahmad, Rafiq},
Editor = {Thiede, S and Lutters, E},
Title = {Integrated Smart Monitoring Technologies for Plastic Sorting and
   Classification Applicable to Learning Factories Design},
Booktitle = {LEARNING FACTORIES OF THE FUTURE, VOL 1, CLF 2024},
Series = {Lecture Notes in Networks and Systems},
Year = {2024},
Volume = {1059},
Pages = {197-204},
Note = {14th International Conference on Learning Factories (CLF), Univ Twente,
   Enschede, NETHERLANDS, APR 17-19, 2024},
Abstract = {The increasing global concern over sustainability in learning factories
   and plastic waste necessitates innovative solutions for efficient
   sorting and recycling processes. Here, we present a research endeavor
   that combines cutting-edge technologies to address this challenge within
   the context of learning factories. Specifically, we have integrated a
   YOLOv5 Object Detection Model with a Near-Infrared Spectroscopy Sensor
   manufactured by Matoha company into a portable, flexible, and
   cost-effective decision-making architecture. Our system is designed to
   classify plastic waste items into object types (bag, bottle, or
   3D-printed part) using object detection and into polymer types (e.g.,
   PE, PET) using spectroscopy. The YOLOv5 model achieved an accurate mean
   average precision (mAP{[}0.5:0.95]) of 0.929. Additionally, this
   research showcases the successful integration of state-of-the-art
   technologies and demonstrates their practical application towards
   implementation into learning factories. The project promotes
   interdisciplinary learning by merging computer vision, sensor
   technology, and waste management, offering students and professionals
   hands-on experience in solving complex, real-world problems. Infusion of
   this project in learning factories can catalyze future projects whereby
   students can implement portable waste sorting mechanisms in their
   universities to attract stakeholders to transform these technologies to
   larger scales and address the critical environ-mental plastic waste
   problem.},
Publisher = {SPRINGER INTERNATIONAL PUBLISHING AG},
Address = {GEWERBESTRASSE 11, CHAM, CH-6330, SWITZERLAND},
Type = {Proceedings Paper},
