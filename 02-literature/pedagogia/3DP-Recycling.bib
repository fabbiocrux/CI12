@inproceedings{ WOS:001260983500287,
Author = {Belkadi, Dhiya and Kim, Min Sung and Hahn, Carl P. and Saleha, Sunehra
   and Houston, Hannah L. and Hussain, Muhammad Mustafa},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Additively Manufactured Dissolvable Electronics Packaging for
   Sustainability},
