@inproceedings{ WOS:001592886300008,
Author = {Suchecki, Lukasz and Jakubas, Adam},
Book-Group-Author = {IEEE},
Title = {Comparative Analysis of Electromagnetic Field Shielding Effectiveness in
   Composite Products Manufactured via Pressing and 3D Printing Techniques},
Booktitle = {2025 PROGRESS IN APPLIED ELECTRICAL ENGINEERING, PAEE},
Series = {Progress in Applied Electrical Engineering PAEE},
Year = {2025},
Note = {2025 Progress in Applied Electrical Engineering Conference-PAEE,
   Zakopane, POLAND, JUN 23-27, 2025},
Abstract = {The development and miniaturization of electronics and communication
   technologies brings new challenges related to the generation of
   high-frequency electromagnetic waves, which can cause interference in
   the operation of other devices. In the area of interest of researchers
   and industry, various types of electromagnetic field shielding solutions
   can be found, including those based on recycled materials. The presented
   research focused on two methods of screen production, i.e. hot pressing
   and additive printing, which are among the simplest technologically and
   economically efficient. A matrix of pulverized high-density polyethylene
   (HPDE) from recycling was selected for the research, mill scale, crushed
   nanocrystalline sheet, short carbon fibers and Fe2O3 powder were
   selected as the filling. Cuboidal samples with dimensions a = 100 mm h =
   1 mm were produced from them using both methods, and then the results of
   shielding effectiveness were compared in the frequency range from 8 GHz
   to 13 GHz.},
