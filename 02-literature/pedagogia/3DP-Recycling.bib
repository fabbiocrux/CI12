DOI = {10.1007/978-3-031-64269-2\_17},
ISSN = {2730-9576},
ISBN = {978-3-031-64271-5; 978-3-031-64269-2; 978-3-031-64268-5},
Keywords = {3D printing concrete; Low-carbon; Rheology; Recycled aggregate;
   Nano-silica treatment},
Research-Areas = {Construction \& Building Technology},
