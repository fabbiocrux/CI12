@article{ WOS:001306231200007,
Author = {Kim, Ju Wan and Kim, Chanwoo and Na, Hyunjin and Lee, Seongmin and Seok,
   Suyeon and Byeon, Seongyong and Kim, Young Kyu and Kim, Seok-min},
Title = {Fabrication of vitreous carbon grid structures by carbonization of 3D
   printed parts for water-oil separation},
Journal = {JOURNAL OF MECHANICAL SCIENCE AND TECHNOLOGY},
Year = {2024},
Volume = {38},
Number = {9},
Pages = {4557-4562},
Month = {SEP},
Abstract = {An effective oil separating technique from water-oil mixture can be used
   in various industrial fields such as environmental purification and
   resource recycling. In this study, a vitreous carbon (VC) grid structure
   was fabricated by carbonization of digital light processing (DLP) 3D
   (3-dimensional) printed parts, and its oil separation performance was
   evaluated. A planner DVC grid structure with pore sizes of similar to
   200, similar to 430 and similar to 520 mu m was fabricated and its
   water-oil separation performance werewas evaluated. Despite theoretical
   calculations suggesting adequate water repelling pressures for pores
   around similar to 300 and similar to 360 mu m, actual performance fell
   short due to defects from 3D printing and carbonization processes. A
   more robust design approach involves fabricating a cuboid shell-shaped
   VC grid structure with smaller pores (similar to 150 mu m),
   demonstrating continuous water-oil separation capabilities.},
