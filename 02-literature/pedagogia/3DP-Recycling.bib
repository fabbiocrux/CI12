@article{ WOS:001269871300001,
Author = {Richter, Andreas and Hansal, Wolfgang E. G.},
Title = {11th European Pulse Plating Seminar/EAST Forum 2024, Vienna},
Journal = {TRANSACTIONS OF THE INSTITUTE OF METAL FINISHING},
