@article{ WOS:001246295200001,
Author = {Epasto, Gabriella and Rizzo, Daniele and Landolfi, Luca and Detry,
   Andrea Lorenzo Henri Sergio and Papa, Ilaria and Squillace, Antonino},
Title = {Design of monomaterial sandwich structures made with foam additive
   manufacturing},
