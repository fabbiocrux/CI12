@inproceedings{ WOS:001502235300152,
Author = {Schwarz, Oliver},
Editor = {Teti, R},
Title = {Transfer of synthesis, logistic and recycling processes in nature to
   industrial processes},
Booktitle = {17TH CIRP CONFERENCE ON INTELLIGENT COMPUTATION IN MANUFACTURING
   ENGINEERING, CIRP ICME 2023},
