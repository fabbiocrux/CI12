@article{ WOS:001379742800001,
Author = {Raut, Prathamesh and Kulkarni, Deepali Sanjay and Kandasubramanian,
   Balasubramanian},
Title = {The Role of Polyurethane and Its Composites in Additive Manufacturing of
   Sensors},
Journal = {POLYMER-PLASTICS TECHNOLOGY AND MATERIALS},
Year = {2025},
Volume = {64},
Number = {6},
Pages = {850-862},
Month = {APR 13},
Abstract = {Polyurethanes (PU) are emerging as pivotal material for future, owing to
   its exceptional versatility and adaptability across a myriad of
   industries. Its unique combination of properties, including flexibility,
   durability, versatility, positions it as a cornerstone for
   technological-advancements and sustainable-practices. These properties
   of polyurethanes make it ideal for applications in healthcare,
   environmental monitoring, and wearable technology. PU exhibits good
   resistance to chemicals and environmental conditions, which is
   beneficial for sensors operating in harsh environments. Sustainability
   is another crucial domain where polyurethane demonstrates substantial
   impact. Advances in recycling and the development of bio-based
   polyurethanes are fostering more eco-friendly manufacturing processes
   such as 3D printing. 3D printing, has become a valuable technique for
   creating cost-effective pathways for manufacturing crucial components in
   biomedical, wearable-technology, and defense-sectors using polymers.
   Additive manufacturing enables precise customization of sensor designs,
   improving their efficiency and effectiveness for specific applications
   whilst contributing to more sustainable production. This review provides
   a comprehensive study on usage of different additive manufacturing
   techniques for fabrication of polyurethane-based sensors. It includes a
   comparative analysis of various 3D printing techniques for fabricating
   these sensors, along with additives used with polyurethane to modify the
   properties of different sensor types, including strain sensors,
   capacitive sensors, and pressure sensors.},
