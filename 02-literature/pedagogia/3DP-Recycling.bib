@article{ WOS:001483412000001,
Author = {Husain, Minhaz and Kumar, Ranvijay and Singh, Rupinder and Singh,
   Gurminder and Kumar, Vinay},
Title = {On Compressive Properties of 3D-Printed High-Density
   Polyethylene-Stubble Waste Composite Tiles},
