@article{ WOS:001399588700001,
Author = {Kamble, Ganesh N. and Asha, S. K.},
Title = {Biobased Reprintable Bis-Dynamic Covalent Photopolymer Composition for
   Digital Light Processing 3D Printing with Self-Healing Properties},
Journal = {ACS APPLIED POLYMER MATERIALS},
Year = {2025},
Month = {2025 JAN 16},
Abstract = {The design and formulation of an environmentally friendly, renewable,
   and reusable biobased resin for additive manufacturing is highly
   sought-after. Materials that incorporate covalent adaptable network
   (CAN) chemistry, which facilitate recycling, show significant promise.
   However, it is challenging to develop biobased vitrimer materials for 3D
   printing applications that are reprintable. In this study, we present a
   bis-dynamic covalent polymer network derived from cystamine and
   vanillin, featuring disulfide- and imine-based dynamic covalent bonds.
   The cystamine methacrylate vanillin (CMAV) was designed and synthesized
   by using vanillin and cystamine under mild reaction conditions at room
   temperature without the requirement for any catalyst. Three series of
   resin formulations were created using 15, 25, and 35 wt \% CMAV with
   isobornyl acrylate as a reactive diluent and
   2,4,6-trimethylbenzoyldiphenyl phosphine oxide (TPO) as a
   photoinitiator. The 3D printing capabilities of these resin formulations
   were validated by using a DLP 3D printer. The resulting 3D-printed
   objects exhibited self-healing ability and shape memory effect at both
   ambient and elevated temperatures of 90 degrees C. The reprintability
   was confirmed by heating the 3D-printed objects with an excess of
   diethylene triamine (DETA) in the presence of THF at 80 degrees C for 48
   h. Subsequently, vanillin methacrylate was added to the viscous resin
   obtained after the removal of THF, enabling further 3D printing.},
