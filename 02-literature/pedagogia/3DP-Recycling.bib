@inproceedings{ WOS:001501412600155,
Author = {Wen, Xin and Bae, S. Sandra and Rivera, Michael L.},
Book-Group-Author = {ACM},
Title = {Enabling Recycling of Multi-Material 3D Printed Objects through
   Computational Design and Disassembly by Dissolution},
Booktitle = {PROCEEDINGS OF THE 2025 CHI CONFERENCE ON HUMAN FACTORS IN COMPUTING
   SYTEMS, CHI 2025},
Year = {2025},
Note = {2025 Conference on Human Factors in Computing Systems-CHI, Yokohama,
   JAPAN, APR 26-MAY 01, 2025},
Abstract = {Multi-material 3D printing combines the functional properties of
   different materials (e.g., mechanical, electrical, color) within a
   single object that is fabricated without manual assembly. However, this
   presents sustainability challenges as multi-material objects cannot be
   easily recycled. Because each material has a different processing
   temperature, considerable effort must be used to separate them for
   recycling. This paper presents a computational fabrication technique to
   generate dissolvable interfaces between different materials in a 3D
   printed object without affecting the object's intended use. When the
   interfaces are dissolved, the object is disassembled to enable recycling
   of the individual materials. We describe the computational design of
   these interfaces alongside experimental evaluations of their strength
   and water solubility. Finally, we demonstrate our technique across 9
   multi-material 3D printed objects of varying structural and functional
   complexity. Our technique enables us to recycle 89.97\% of the total
   mass of these objects, promoting greater sustainability in 3D printing.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1601 Broadway, 10th Floor, NEW YORK, NY, UNITED STATES},
Type = {Proceedings Paper},
Language = {English},
