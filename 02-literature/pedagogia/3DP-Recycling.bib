@article{ WOS:001566858700001,
Author = {You, Jhu-Lin and Chao, Wei-Cheng and Li, Cheng-Ying and Tung, Shih-Huang
   and Liao, Ying-Chih},
Title = {Sustainable and recyclable poly(urea-urethane) photocurable resin with
   dynamic hindered urea bonds for green manufacturing applications},
Journal = {SUSTAINABLE MATERIALS AND TECHNOLOGIES},
Year = {2025},
Volume = {45},
Month = {OCT},
Abstract = {In response to the urgent need for sustainable, eco-friendly materials
   for manufacturing, this study introduces a zero-VOC, recyclable
   poly(urea-urethane) acrylate (PUUA) photocurable resin featuring dynamic
   hindered urea bonds (HUBs). The innovative molecular design integrates
   2-(tert-butylamino)ethyl methacrylate (TBEA) and N, N
   `-di-tert-butylethylenediamine (BEDA) to enable complete liquefaction at
   100 C-degrees within 3 h, allowing for multiple recycling and
   reprocessing cycles under mild conditions, free of catalysts and
   solvents. This dynamic covalent network achieves high thermal stability,
   optical clarity, and exceptional mechanical properties (tensile strength
   >40 MPa, compressive strength >200 MPa), maintaining performance even
   after two recycling cycles. Using a high-resolution LCD 3D printer,
   complex prototypes-including functional components-were fabricated with
   excellent dimensional accuracy and minimal light scattering. The resin
   exhibits low viscosity, high transmittance (>80 \%), and a curing depth
   exceeding 55 mu m, critical for efficient printing. By offering a green,
   scalable solution for producing recyclable, high-performance
   photocurable resins, this work paves the way for sustainable materials
   technologies and circular manufacturing practices, addressing both
   environmental impact and industrial scalability.},
