@inproceedings{ WOS:001487145100008,
Author = {Wolf, Jan and Gerold, Jonas and Moehring, Hans-Christian},
Editor = {Settineri, L and Priarone, PC},
Title = {Development of an Extraction Hood for Efficient Chip Collection during
   the Finishing Process of FFF 3D Printed Parts},
Booktitle = {31ST CIRP CONFERENCE ON LIFE CYCLE ENGINEERING, LCE 2024},
Series = {Procedia CIRP},
Year = {2024},
