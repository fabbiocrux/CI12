@article{ WOS:001494743700008,
Author = {Chen, Yueru and Guo, Zongning and Huang, Xuelin and Qu, Jiangying and
   Gao, Feng and Wan, Kai and Zhang, You and Zhao, Xiaofang and Jiao, Zhe},
Title = {Portable field detection device based on Por-COF-MF for the
   determination of SO2 in wine},
Journal = {MICROCHEMICAL JOURNAL},
Year = {2025},
Volume = {214},
Month = {JUL},
Abstract = {In this study, we designed a fluorescent Por-COF-MF, for selective
   detection SO2 in wine. The fluorescence was quenched due to the
   intramolecular charge transfer (ICT) process blocked by SO2. A good
   linear relationship of fluorescent intensity with SO2 in the
   concentration range of 0.01-1 ppm was found. To achieve facile
   solid-state detection, Por-COF-MF was loaded on polyvinyl alcohol (PVA)
   to fabricate a uniform fluorescent film Por-COFMF@PVA. Then a portable
   device was designed by 3D printing technology. The device exhibited good
   linearity in the SO2 concentration range of 0.5-3 ppm, with a detection
   limit of 0.06 ppm. The relative standard deviation (RSD) was less than 8
   \% when measuring SO2 in three different types of wine. Compared to
   other portable technologies, our 3D-printed fluorescent device allowed
   for direct detection of SO2 content in wine, which provided a more
   effective and economical method for food safety monitoring.},
