@article{ WOS:001494240900001,
Author = {Ror, Ch Kapil and Mishra, Vishal and Negi, Sushant},
Title = {Investigation of Physio-Mechanical Properties of Recycled PET Derived
   from Post-Consumer Soda and Water Bottles for Sustainable 3D Printing
   via Fused Deposition Modeling},
Journal = {JOURNAL OF MATERIALS ENGINEERING AND PERFORMANCE},
Year = {2025},
Volume = {34},
Number = {23},
Pages = {28581-28592},
Month = {DEC},
Abstract = {This research investigated the viability of utilizing recycled
   polyethylene terephthalate (RPET) derived from post-consumer PET soda
   bottles (RPET-SF) and PET water bottles (RPET-WF) as a 3D printing
   material. The physical and mechanical properties of RPET-SF and RPET-WF
   samples were examined across varying temperature conditions and compared
   with those of virgin PET (VPET) samples. The findings indicated that
   RPET-SF samples exhibited the lowest density, hardness, and average
   surface roughness values. However, tensile tests revealed that RPET-SF
   printed at 250 degrees C demonstrated the highest tensile strength (TS).
   Specifically, RPET-SF displayed a tensile modulus (E), yield strength
   (sigma y), and ultimate tensile strength (UTS) of 1250.8 +/- 70 MPa,
   23.31 +/- 1.5 MPa, and 34.08 +/- 3 MPa, respectively. These values were
   37.8\%, 19.3\%, and 56.62\% higher than those of VPET samples.
   Additionally, RPET-SF printed at 260 degrees C exhibited the maximum
   flexural strength of 44.78 +/- 2.33 MPa. In conclusion, the obtained
   data suggest that recycled PET can be effectively employed as a 3D
   printing material, and this study provides valuable insights for
   achieving enhanced mechanical performance with recycled PET.},
