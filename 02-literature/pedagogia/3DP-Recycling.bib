@article{ WOS:001597703100001,
Author = {da Silva, Kelly Cristina Dantas and Pereira, Anderson da Silva and
   Resende, Beatriz Vitorino and de Oliveira, Wallace Burger Verissimo and
   Silva, Shayla Chrystin dos Santos and dos Santos, Diego Coelho Barroso
   and Ghesti, Grace Ferreira and Matos, Renato Camargo and Campos, Naira
   da Silva and Lisboa, Thalles Pedrosa},
Title = {Biochar-based composite material integrated into a 3D-printed
   electrochemical support: an affordable and sustainable device for
   levofloxacin antibiotic monitoring},
Journal = {SUSTAINABLE MATERIALS AND TECHNOLOGIES},
Year = {2025},
Volume = {46},
Month = {DEC},
Abstract = {The pursuit of greater sustainability has driven policies that emphasize
   the 3Rs - reducing consumption, reusing materials, and recycling waste.
   Additive manufacturing (3D printing) is a technique aligned with these
   approaches and also allows for integration with other eco-friendly
   practices. Therefore, in this work, we developed an electrochemical
   device fabricated via 3D-printed support with a composite material of
   acrylonitrile butadiene styrene (ABS) polymer waste, graphite and
   rice-husk bio-charcoal (biochar). The device was thoroughly
   characterized by Raman spectroscopy, scanning electron microscopy,
   electrochemical impedance spectroscopy, and cyclic voltammetry. A square
   wave voltammetry method was developed to monitor the third-generation
   fluoroquinolone levofloxacin (LEV) in supply and river water samples.
   The optimized method showed a linear response from 1 to 20 mu mol/L and
   a detection limit of 0.39 mu mol/L. Moreover, the method also exhibited
   good precision (RSD < 6.8 \%) and excellent accuracy, with recoveries of
   100-107 \% in spiked samples. Finally, the sensor showed robust
   stability and selectivity in the presence of other antibiotic and
   antipyretic compounds, highlighting its suitability and broad potential
   in electroanalytical applications.},
