@article{ WOS:001509076100004,
Author = {Zhang, Jia-Jia and Zhu, Ran-Xi and Wang, Yu-Chang and Zhao, Chun-Yi and
   Yan, Wen-Fu and Jin, Juan and Dong, Hao and Wang, Peng and Jiao, Yu-Wan
   and Liu, Yong-Feng},
Title = {Synthesis and Visible-Light photocatalytic properties of an
   Oxalate-Extended Sr(II) Coordination polymer for Organic Dye Degradation},
Journal = {JOURNAL OF MOLECULAR STRUCTURE},
Year = {2025},
Volume = {1343},
Month = {OCT 25},
Abstract = {The large discharge of dyeing and printing wastewater is one of the
   current environmental problems we face. Photocatalytic technology has
   strong advantages in degrading dyeing and printing wastewater and has
   achieved significant results. Coordination polymers are widely used in
   photocatalysis due to their high specific surface area and regular
   crystal structure. 3-Nitrophthalic acid (3-NPA), N2H4 \& sdot;H2O,
   oxalic acid (H2ox) and Sr(NO3)2 were used as raw materials to prepare a
   light yellow crystal {[}Sr(ox)] (CP-Sr; ox = oxalate) by hydrothermal
   synthesis. CP-Sr was a 3D network structure directly expanded by oxalic
   acid, which had excellent visible light catalytic performance.
   Corresponding data such as X-ray single crystal data are placed in Table
   2. CP-Sr exhibited its highest methylene blue (MB) degradation
   efficiency (71.1 \%) at pH = 4 after 70 min of irradiation. The
   photocatalytic efficiency could be improved by adding H2O2 (84.5 \%).
   CP-Sr exhibited the highest rhodamine B (RhB) degradation efficiency
   (69.7 \%) at pH = 4 after 180 min irradiation. The degradation
   efficiency with H2O2 was 76.4 \%. The photocatalytic degradation results
   can be described in terms of first-order kinetics. After five times of
   reuse, it was found that the degradation rate decreased less, so the
   recycling ability was better. The free radicals which play a major role
   in the whole photocatalytic process were investigated through free
   radical trapping experiments and ESR test. Finally, the Mott-Schottky
   curve of CP-Sr was tested to further explored its possible
   photocatalytic degradation mechanism.},
