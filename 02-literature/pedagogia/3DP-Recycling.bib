@article{ WOS:001502124600001,
Author = {Xie, Huilin and Xiao, Guang and Ren, Geng and Lu, Guodong and Chen, Wu
   and Zhang, Huimei and Li, Jialei and Luo, Wenjie and Zhang, Hongjie and
   Zhu, Weipu and Cai, Qiuquan},
Title = {Modular Molecular Editing of End-of-Life PBT for High-Performance
   Sustainable and 3D-Printable Platforms},
