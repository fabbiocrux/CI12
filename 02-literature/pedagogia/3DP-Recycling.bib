@article{ WOS:001616562900002,
Author = {Dey, Debanjali and Joseph, Antony and Tiwary, Chandra Sekhar and
   Chowdhury, Shamik and Sen, Ramkrishna},
Title = {3D printed F-doped g-C3N4 reinforced porous boehmite for efficient
   degradation of broad-spectrum antibiotics under visible light
   irradiation},
Journal = {SEPARATION AND PURIFICATION TECHNOLOGY},
Year = {2026},
Volume = {382},
Number = {3},
Month = {FEB 26},
Abstract = {The excessive use and unregulated release of antibiotics into aquatic
   environments necessitate innovative wastewater treatment methods to
   disintegrate these micropollutants into benign products. Heterogeneous
   photocatalysis is a highly efficient and sustainable approach for
   degrading persistent organic pollutants. However, conventional powdery
   catalysts are difficult to recycle, leading to secondary pollution and
   limiting practical applications. To overcome this, additive
   manufacturing enables the fabrication of tailored photocatalytic
   architectures that optimize light absorption, charge separation, and
   mass transfer, thereby improving efficiency. Herein, we report the
   successful fabrication of 3D printed fluorine (F)-doped graphitic carbon
   nitride (g-C3N4)reinforced porous boehmite (FCN-Bo) via direct ink
   writing. Compared to pristine sintered boehmite, FCN-Bo exhibits
   excellent photocatalytic activity, achieving 89 \% sulfamethoxazole
   (SMZ) and 91.5 \% ofloxacin (OFC) removal within 180 min under visible
   light irradiation. The versatility of FCN-Bo is further demonstrated by
   the simultaneous degradation of antibiotic cocktails across five real
   water matrices, while the toxicity of by-products is assessed through
   quantitative structure-activity relationship analysis. From a practical
   standpoint, the 3D printed FCN-Bo shows remarkable photostability and
   reusability over multiple cycles, underscoring its potential for
   real-world wastewater treatment. These findings establish FCN-Bo as an
   effective material for antibiotic removal and pave the way for
   next-generation 3D printed photocatalysts tailored for decentralized
   applications.},
